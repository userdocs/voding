#!/bin/bash

#################################################################################################################################################
# Global color variables for main script sections
#################################################################################################################################################
readonly color_red="\e[31m"
readonly color_green="\e[32m"
readonly color_yellow="\e[33m"
readonly color_blue="\e[34m"
readonly color_cyan="\e[36m"
readonly color_magenta="\e[35m"
readonly color_gray="\e[37m"
readonly color_end="\e[0m"
readonly text_bold="\e[1m"

# Check patch headers for '..' path traversal components before invoking git/patch
patch_has_path_traversal() {
	local patch_file="$1"
	grep -qE '^(\+\+\+|---|diff --git )[[:space:]].*(^|[/"[:space:]])\.\.(/|[[:space:]"]|$)' -- "$patch_file" 2> /dev/null
}

# Attempt git apply --3way transactionally so failed merges (or dry-run checks)
# never leave conflict markers, partial multi-file changes, or dirty index entries,
# while preserving any prior uncommitted modifications in the working tree.
git_try_3way() {
	local git_repo="$1"
	local patch_file="$2"
	local dry_run="$3"

	local -a paths=() existed_paths=() created_paths=()
	local rec p
	while IFS= read -r -d '' rec; do
		if [[ $rec == *$'\t'* ]]; then
			p="${rec#*$'\t'}"
			p="${p#*$'\t'}"
			[[ -n $p ]] && paths+=("$p")
		elif [[ -n $rec ]]; then
			paths+=("$rec")
		fi
	done < <(git -C "$git_repo" apply --numstat -z -- "$patch_file" 2> /dev/null)

	# If patch cannot be parsed by git apply --numstat, --3way cannot succeed
	[[ ${#paths[@]} -gt 0 ]] || return 1

	local index_path
	index_path=$(git -C "$git_repo" rev-parse --git-path index 2> /dev/null) || return 1
	if [[ $index_path != /* ]]; then
		index_path="${git_repo}/${index_path}"
	fi

	local snap_dir
	snap_dir=$(mktemp -d) || return 1

	if [[ -f $index_path ]]; then
		cp -pf -- "$index_path" "$snap_dir/index.bak" 2> /dev/null || {
			rm -rf -- "$snap_dir"
			return 1
		}
	fi

	for p in "${paths[@]}"; do
		if [[ $p == /* || $p == *..* ]]; then
			rm -rf -- "$snap_dir"
			return 1
		fi
		if [[ -e "$git_repo/$p" || -L "$git_repo/$p" ]]; then
			mkdir -p -- "$snap_dir/files/$(dirname "$p")"
			cp -a -- "$git_repo/$p" "$snap_dir/files/$p" || {
				rm -rf -- "$snap_dir"
				return 1
			}
			existed_paths+=("$p")
		else
			created_paths+=("$p")
		fi
	done

	local apply_rc=0
	git -C "$git_repo" apply --3way -- "$patch_file" > /dev/null 2>&1 || apply_rc=$?

	if [[ $apply_rc -ne 0 || $dry_run == "true" ]]; then
		if [[ -f "$snap_dir/index.bak" ]]; then
			cp -pf -- "$snap_dir/index.bak" "$index_path" 2> /dev/null
		else
			rm -f -- "$index_path"
		fi
		for p in "${created_paths[@]}"; do
			rm -rf -- "${git_repo:?}/${p:?}"
		done
		for p in "${existed_paths[@]}"; do
			mkdir -p -- "$git_repo/$(dirname "$p")"
			rm -rf -- "${git_repo:?}/${p:?}"
			cp -a -- "$snap_dir/files/$p" "$git_repo/$p"
		done
	fi

	rm -rf -- "$snap_dir"
	return "$apply_rc"
}

apply_patches() {
	local patch_dir="${1:-patches}"
	local dry_run="${2:-false}"
	local verbose="${3:-false}"
	local force="${4:-false}"
	local git_repo="${5:-}"
	local failed_patches_file="${6:-}"
	local delete_failed="${7:-false}"
	local caller_dir="${PWD}"

	# Unicode circles - the main symbols used throughout the script
	local unicode_red_circle="\e[31m"$'\U2B24'"\e[0m"
	local unicode_green_circle="\e[32m"$'\U2B24'"\e[0m"
	local unicode_yellow_circle="\e[33m"$'\U2B24'"\e[0m"
	local unicode_blue_circle="\e[34m"$'\U2B24'"\e[0m"

	# Validate boolean flags when called as a library function
	local flag_val
	for flag_val in "$dry_run" "$verbose" "$force" "$delete_failed"; do
		if [[ $flag_val != "true" && $flag_val != "false" ]]; then
			printf '\n%b Invalid boolean parameter: %s (expected true or false)\n' "$unicode_red_circle" "$flag_val" >&2
			return 1
		fi
	done

	# Validate caller directory exists (sanity check)
	if [[ ! -d $caller_dir ]]; then
		printf '\n%b Current directory is not accessible\n' "$unicode_red_circle" >&2
		return 1
	fi

	#################################################################################################################################################
	# Display DRY RUN mode warning if enabled - let the user know what's going on
	#################################################################################################################################################
	if [[ $dry_run == "true" ]]; then
		printf '\n%b%b%s%b\n' "${text_bold}" "${color_yellow}" "=== DRY RUN MODE (Default) ===" "${color_end}"
		printf '\n%b%s%b\n' "${color_gray}" "This script is running in DRY RUN mode and will NOT apply any patches." "${color_end}"
		printf '\n%b%s%b\n' "${color_green}" "Use '--apply' or '-a' flag to actually apply patches." "${color_end}"
		printf '\n%b%b%s%b\n' "${text_bold}" "${color_yellow}" "================================" "${color_end}"
	fi

	# Array to track failed patches
	local failed_patches=()

	# Handle target / git repository directory without mutating caller's PWD
	local is_git_repo="false"
	if [[ -n $git_repo ]]; then
		if [[ $git_repo != /* ]]; then
			git_repo="${caller_dir}/${git_repo}"
		fi

		if [[ ! -d $git_repo ]]; then
			printf '\n%b Target directory %b%s%b not found\n' "${unicode_red_circle}" "${color_blue}" "'$git_repo'" "${color_end}" >&2
			return 1
		fi

		if [[ -e $git_repo/.git ]] && command -v git > /dev/null 2>&1 && git -C "$git_repo" rev-parse --git-dir > /dev/null 2>&1; then
			is_git_repo="true"
			printf '\n%b Target git repository: %b%s%b\n' "${unicode_blue_circle}" "${color_blue}" "$git_repo" "${color_end}"
		else
			is_git_repo="false"
			printf '\n%b Target directory (not a git repo): %b%s%b\n' "${unicode_blue_circle}" "${color_blue}" "$git_repo" "${color_end}"
		fi
	else
		git_repo="${caller_dir}"
		if [[ -e $git_repo/.git ]] && command -v git > /dev/null 2>&1 && git -C "$git_repo" rev-parse --git-dir > /dev/null 2>&1; then
			is_git_repo="true"
		else
			is_git_repo="false"
		fi
	fi

	# Verify required tool exists before processing patches (prevents false failures and -x mass deletion)
	if [[ $is_git_repo == "false" ]] && ! command -v patch > /dev/null 2>&1; then
		printf '\n%b Error: '\''patch'\'' command not found in PATH\n' "${unicode_red_circle}" >&2
		return 1
	fi

	# If patch_dir is not an absolute path, make it relative to caller's directory
	if [[ $patch_dir != /* ]]; then
		patch_dir="${caller_dir}/${patch_dir}"
	fi

	if [[ ! -d $patch_dir ]]; then
		printf '\n%b Patch directory %b%s%b not found\n' "${unicode_red_circle}" "${color_blue}" "$patch_dir" "${color_end}" >&2
		return 1
	fi

	# Collect patch files in lexicographical order across both .patch and .diff
	local patch_files=()
	local patch_file
	for patch_file in "$patch_dir"/*; do
		if [[ -f $patch_file && ($patch_file == *.patch || $patch_file == *.diff) ]]; then
			patch_files+=("$patch_file")
		fi
	done

	if [[ ${#patch_files[@]} -eq 0 ]]; then
		printf '\n%b %bWARNING:%b No patch files found in directory %b%s%b\n' "${unicode_yellow_circle}" "${color_yellow}" "${color_end}" "${color_blue}" "$patch_dir" "${color_end}" >&2
		printf '\n%b %bExpected file extensions:%b .patch or .diff\n' "${unicode_blue_circle}" "${color_cyan}" "${color_end}" >&2
		return 1
	fi

	if [[ $is_git_repo == "true" ]]; then
		if [[ $dry_run == "true" ]]; then
			printf '\n%b %bDRY RUN:%b Checking patches from %b%s%b for git repository %b%s%b...\n' "${unicode_blue_circle}" "${color_yellow}" "${color_end}" "${color_blue}" "$patch_dir" "${color_end}" "${color_blue}" "$git_repo" "${color_end}"
		else
			printf '\n%b %bAPPLYING:%b patches from %b%s%b to git repository %b%s%b...\n' "${unicode_red_circle}" "${color_red}" "${color_end}" "${color_blue}" "$patch_dir" "${color_end}" "${color_blue}" "$git_repo" "${color_end}"
		fi
	else
		if [[ $dry_run == "true" ]]; then
			printf '\n%b %bDRY RUN:%b Checking patches from %b%s%b for directory %b%s%b (using patch command)...\n' "${unicode_blue_circle}" "${color_yellow}" "${color_end}" "${color_blue}" "$patch_dir" "${color_end}" "${color_blue}" "$git_repo" "${color_end}"
		else
			printf '\n%b %bAPPLYING:%b patches from %b%s%b to directory %b%s%b (using patch command)...\n' "${unicode_red_circle}" "${color_red}" "${color_end}" "${color_blue}" "$patch_dir" "${color_end}" "${color_blue}" "$git_repo" "${color_end}"
		fi
	fi

	for patch_file in "${patch_files[@]}"; do
		local patch_name="${patch_file##*/}"
		printf '\n%b Processing: %b%s%b\n' "${unicode_blue_circle}" "${color_cyan}" "$patch_name" "${color_end}"

		local error_message=""

		if patch_has_path_traversal "$patch_file"; then
			error_message="Security: patch contains parent directory traversal ('..')"
			printf '  %b %bFailed%b\n' "${unicode_red_circle}" "${color_red}" "${color_end}"
			printf '  %b %bReason:%b\n      %s\n' "${unicode_yellow_circle}" "${color_yellow}" "${color_end}" "$error_message"
			failed_patches+=("$patch_name")
			continue
		fi

		if [[ $dry_run == "true" ]]; then
			if [[ $is_git_repo == "true" ]]; then
				if error_message=$(git -C "$git_repo" apply --check -- "$patch_file" 2>&1); then
					printf '\n  %b %bOK%b\n' "${unicode_green_circle}" "${color_green}" "${color_end}"
				elif [[ $force == "true" ]] && git -C "$git_repo" apply --check --ignore-whitespace -- "$patch_file" 2> /dev/null; then
					printf '\n  %b %bOK (ignored whitespace)%b\n' "${unicode_green_circle}" "${color_green}" "${color_end}"
				elif git_try_3way "$git_repo" "$patch_file" "true"; then
					printf '\n  %b %bOK (3-way merge)%b\n' "${unicode_green_circle}" "${color_green}" "${color_end}"
				else
					printf '  %b %bFailed%b\n' "${unicode_red_circle}" "${color_red}" "${color_end}"
					failed_patches+=("$patch_name")
					[[ $verbose != "true" ]] && error_message="${error_message%%$'\n'*}"
					printf '  %b %bReason:%b\n' "${unicode_yellow_circle}" "${color_yellow}" "${color_end}"
					printf '%s\n' "$error_message" | sed 's/^/      /'
				fi
			else
				# Use patch command in batch/forward mode for non-git directories
				if error_message=$(patch -d "$git_repo" --batch --forward --no-backup-if-mismatch -r - --dry-run -p1 -i "$patch_file" 2>&1); then
					printf '\n  %b %bOK%b\n' "${unicode_green_circle}" "${color_green}" "${color_end}"
				elif [[ $force == "true" ]] && patch -d "$git_repo" --batch --forward --no-backup-if-mismatch -r - --ignore-whitespace --dry-run -p1 -i "$patch_file" > /dev/null 2>&1; then
					printf '\n  %b %bOK (ignored whitespace)%b\n' "${unicode_green_circle}" "${color_green}" "${color_end}"
				else
					printf '\n  %b %bFailed%b\n' "${unicode_red_circle}" "${color_red}" "${color_end}"
					failed_patches+=("$patch_name")
					[[ $verbose != "true" ]] && error_message="${error_message%%$'\n'*}"
					printf '  %b %bReason:%b\n' "${unicode_yellow_circle}" "${color_yellow}" "${color_end}"
					printf '%s\n' "$error_message" | sed 's/^/      /'
				fi
			fi
		else
			local applied="false"

			if [[ $is_git_repo == "true" ]]; then
				# Git repository - use transactional 3-way merge fallback so failed merges never dirty index/worktree
				if error_message=$(git -C "$git_repo" apply -- "$patch_file" 2>&1); then
					printf '\n  %b %bApplied%b\n' "${unicode_green_circle}" "${color_green}" "${color_end}"
					applied="true"
					error_message=""
				elif [[ $force == "true" ]] && git -C "$git_repo" apply --ignore-whitespace -- "$patch_file" 2> /dev/null; then
					printf '  %b %bApplied (ignored whitespace)%b\n' "${unicode_green_circle}" "${color_green}" "${color_end}"
					applied="true"
					error_message=""
				elif git_try_3way "$git_repo" "$patch_file" "false"; then
					printf '  %b %bApplied with 3-way merge%b\n' "${unicode_green_circle}" "${color_green}" "${color_end}"
					applied="true"
					error_message=""
				fi
			else
				# Non-git directory - verify with --dry-run first and suppress .orig/.rej files
				if error_message=$(patch -d "$git_repo" --batch --forward --no-backup-if-mismatch -r - --dry-run -p1 -i "$patch_file" 2>&1) \
					&& patch -d "$git_repo" --batch --forward --no-backup-if-mismatch -r - -p1 -i "$patch_file" > /dev/null 2>&1; then
					printf '\n  %b %bApplied%b\n' "${unicode_green_circle}" "${color_green}" "${color_end}"
					applied="true"
					error_message=""
				elif [[ $force == "true" ]] \
					&& patch -d "$git_repo" --batch --forward --no-backup-if-mismatch -r - --ignore-whitespace --dry-run -p1 -i "$patch_file" > /dev/null 2>&1 \
					&& patch -d "$git_repo" --batch --forward --no-backup-if-mismatch -r - --ignore-whitespace -p1 -i "$patch_file" > /dev/null 2>&1; then
					printf '  %b %bApplied (ignored whitespace)%b\n' "${unicode_green_circle}" "${color_green}" "${color_end}"
					applied="true"
					error_message=""
				fi
			fi

			if [[ $applied == "false" ]]; then
				local reason_summary="${error_message%%$'\n'*}"
				printf '\n  %b %bFailed to apply%b\n' "${unicode_red_circle}" "${color_red}" "${color_end}"
				printf '  %b %bReason:%b\n' "${unicode_yellow_circle}" "${color_yellow}" "${color_end}"
				printf '%s\n' "$reason_summary" | sed 's/^/      /'
				failed_patches+=("$patch_name")
				if [[ $verbose == "true" ]]; then
					local quoted_patch quoted_repo
					printf -v quoted_patch '%q' "$patch_file"
					printf -v quoted_repo '%q' "$git_repo"
					printf '\n%b%s%b\n' "${color_yellow}" "    Detailed error:" "${color_end}"
					if [[ $is_git_repo == "true" ]]; then
						git -C "$git_repo" apply --check --verbose -- "$patch_file" 2>&1 | sed 's/^/      /'
					else
						printf '%s\n' "$error_message" | sed 's/^/      /'
					fi
					printf '\n%b     To fix this patch, try one of these approaches: %b\n' "${color_yellow}" "${color_end}"
					if [[ $is_git_repo == "true" ]]; then
						printf '\n%b  1.%b%b Manual 3-way merge:%b   git -C %s apply --3way --verbose %b%s%b\n' "${color_magenta}" "${color_end}" "${color_green}" "${color_end}" "$quoted_repo" "${color_cyan}" "$quoted_patch" "${color_end}"
						printf '\n%b  2.%b%b Ignore whitespace:%b    git -C %s apply --ignore-whitespace %b%s%b\n' "${color_magenta}" "${color_end}" "${color_green}" "${color_end}" "$quoted_repo" "${color_cyan}" "$quoted_patch" "${color_end}"
						printf '\n%b  3.%b%b Check what failed:%b    git -C %s apply --check --verbose %b%s%b\n' "${color_magenta}" "${color_end}" "${color_green}" "${color_end}" "$quoted_repo" "${color_cyan}" "$quoted_patch" "${color_end}"
						printf '\n%b  4.%b%b Apply with reject:%b    git -C %s apply --reject %b%s%b\n' "${color_magenta}" "${color_end}" "${color_green}" "${color_end}" "$quoted_repo" "${color_cyan}" "$quoted_patch" "${color_end}"
					else
						printf '\n%b     1.%b%b Ignore whitespace:%b    patch -d %s --ignore-whitespace -p1 -i %b%s%b\n' "${color_magenta}" "${color_end}" "${color_green}" "${color_end}" "$quoted_repo" "${color_cyan}" "$quoted_patch" "${color_end}"
						printf '\n%b     2.%b%b Check what failed:%b    patch -d %s --dry-run -p1 -i %b%s%b\n' "${color_magenta}" "${color_end}" "${color_green}" "${color_end}" "$quoted_repo" "${color_cyan}" "$quoted_patch" "${color_end}"
						printf '\n%b     3.%b%b Apply with reject:%b    patch -d %s --reject-file=- -p1 -i %b%s%b\n' "${color_magenta}" "${color_end}" "${color_green}" "${color_end}" "$quoted_repo" "${color_cyan}" "$quoted_patch" "${color_end}"
						printf '\n%b     4.%b%b Try different strip:%b  patch -d %s -p0 -i %b%s%b\n' "${color_magenta}" "${color_end}" "${color_green}" "${color_end}" "$quoted_repo" "${color_cyan}" "$quoted_patch" "${color_end}"
					fi
					printf '\n%b     5.%b%b View patch content:%b   cat %b%s%b\n' "${color_magenta}" "${color_end}" "${color_cyan}" "${color_end}" "${color_yellow}" "$quoted_patch" "${color_end}"
					printf '\n%b     6.%b%b Apply manually:%b       patch -d %s -p1 < %b%s%b\n' "${color_magenta}" "${color_end}" "${color_cyan}" "${color_end}" "$quoted_repo" "${color_yellow}" "$quoted_patch" "${color_end}"
				fi
			fi
		fi
	done

	# Save failed patches to file if requested (or remove stale file if all passed)
	if [[ -n $failed_patches_file ]]; then
		local output_file="$failed_patches_file"
		if [[ $output_file != /* ]]; then
			output_file="${caller_dir}/${failed_patches_file}"
		fi

		if [[ ${#failed_patches[@]} -gt 0 ]]; then
			printf '\n%b Saving %b%d%b failed patch file names to: %b%s%b\n' "${unicode_blue_circle}" "${color_yellow}" "${#failed_patches[@]}" "${color_end}" "${color_blue}" "$output_file" "${color_end}"
			if printf '%s\n' "${failed_patches[@]}" > "$output_file"; then
				printf '%b %b%s%b\n' "${unicode_green_circle}" "${color_green}" "Failed patches saved successfully" "${color_end}"
			else
				printf '%b %b%s%b\n' "${unicode_yellow_circle}" "${color_yellow}" "Warning: Failed to save failed patches to file" "${color_end}" >&2
			fi
		elif [[ -f $output_file ]]; then
			rm -f -- "$output_file"
		fi
	fi

	# Delete failed patches if requested
	if [[ $delete_failed == "true" && ${#failed_patches[@]} -gt 0 ]]; then
		printf '\n%b Deleting %b%d%b failed patch files from: %b%s%b\n\n' "${unicode_red_circle}" "${color_red}" "${#failed_patches[@]}" "${color_end}" "${color_blue}" "$patch_dir" "${color_end}"
		local deleted_count=0
		local failed_count=0

		for patch_name in "${failed_patches[@]}"; do
			local patch_path="$patch_dir/$patch_name"
			if [[ -f $patch_path ]]; then
				if rm -- "$patch_path" 2> /dev/null; then
					printf '  %b %bDeleted:%b %b%s%b\n' "${unicode_green_circle}" "${color_green}" "${color_end}" "${color_cyan}" "$patch_name" "${color_end}"
					((++deleted_count))
				else
					printf '  %b %bFailed to delete:%b %b%s%b\n' "${unicode_red_circle}" "${color_red}" "${color_end}" "${color_yellow}" "$patch_name" "${color_end}" >&2
					((++failed_count))
				fi
			else
				printf '  %b %bNot found:%b %b%s%b\n' "${unicode_yellow_circle}" "${color_yellow}" "${color_end}" "${color_blue}" "$patch_name" "${color_end}" >&2
				((++failed_count))
			fi
		done

		if [[ $deleted_count -gt 0 ]]; then
			printf '\n%b %b%s%b\n' "${unicode_green_circle}" "${color_green}" "Successfully deleted $deleted_count failed patch file(s)" "${color_end}"
		fi
		if [[ $failed_count -gt 0 ]]; then
			printf '%b %b%s%b\n' "${unicode_yellow_circle}" "${color_yellow}" "Warning: Failed to delete $failed_count patch file(s)" "${color_end}" >&2
		fi
	fi

	# Return error code if any patches failed
	if [[ ${#failed_patches[@]} -gt 0 ]]; then
		return 1
	fi
}

# Main execution when script is called directly
if [[ ${BASH_SOURCE[0]} == "${0}" ]]; then

	script_name="${BASH_SOURCE[0]##*/}"

	# Show usage if no arguments provided
	if [[ $# -eq 0 ]]; then
		printf '\n%b%s%b\n' "${color_cyan}" "Usage: $script_name [OPTIONS] [patch_directory]" "${color_end}"
		printf '\n%b%s%b\n' "${color_cyan}" "Check patches from a directory (dry run by default). Use --apply to actually apply them." "${color_end}"
		printf '\n%b%s%b\n' "${color_yellow}" "Basic examples:" "${color_end}"
		printf '\n%b%s%b%b%s%b\n' "${color_green}" "  $script_name my-patches                 " "${color_end}" "${color_cyan}" " # Check patches from 'my-patches' directory (dry run)" "${color_end}"
		printf '\n%b%s%b%b%s%b\n' "${color_green}" "  $script_name -a my-patches              " "${color_end}" "${color_cyan}" " # Apply patches from 'my-patches' directory" "${color_end}"
		printf '\n%b%s%b%b%s%b\n' "${color_green}" "  $script_name -r /path/to/repo my-patches" "${color_end}" "${color_cyan}" " # Check patches for specific directory" "${color_end}"
		printf '\n%b%s%b\n' "${color_blue}" "Use '$script_name --help' for detailed options and usage information." "${color_end}"
		printf '\n'
		exit 0
	fi

	dry_run="true"
	verbose="false"
	force="false"
	patch_dir=""
	git_repo=""
	failed_patches_file=""
	delete_failed_patches="false"

	# Parse command line arguments
	while [[ $# -gt 0 ]]; do
		case "$1" in
			-d | --dry-run)
				dry_run="true"
				shift
				;;
			-a | --apply)
				dry_run="false"
				shift
				;;
			-v | --verbose)
				verbose="true"
				shift
				;;
			-f | --force)
				force="true"
				shift
				;;
			-x | --delete-failed)
				delete_failed_patches="true"
				shift
				;;
			-[davfx][davfx]*)
				flag_cluster="${1#-}"
				while [[ -n $flag_cluster ]]; do
					case "${flag_cluster:0:1}" in
						d) dry_run="true" ;;
						a) dry_run="false" ;;
						v) verbose="true" ;;
						f) force="true" ;;
						x) delete_failed_patches="true" ;;
						*)
							printf '\n%b%s%b\n' "${color_red}" "Unknown option: -${flag_cluster:0:1} (in $1)" "${color_end}" >&2
							printf '\n%b%s%b\n' "${color_blue}" "Use -h or --help for usage information" "${color_end}" >&2
							exit 1
							;;
					esac
					flag_cluster="${flag_cluster:1}"
				done
				shift
				;;
			-r | --repo)
				if [[ $# -ge 2 && -n ${2:-} && $2 != -* ]]; then
					git_repo="$2"
					shift 2
				else
					printf '\n%b%s%b\n' "${color_red}" "Error: --repo requires a directory argument" "${color_end}" >&2
					exit 1
				fi
				;;
			--repo=*)
				git_repo="${1#*=}"
				if [[ -z $git_repo ]]; then
					printf '\n%b%s%b\n' "${color_red}" "Error: --repo requires a directory argument" "${color_end}" >&2
					exit 1
				fi
				shift
				;;
			-s | --save-failed)
				if [[ $# -ge 2 && -n ${2:-} && $2 != -* ]]; then
					failed_patches_file="$2"
					if [[ $2 == */* ]]; then
						save_parent="${2%/*}"
						[[ -z $save_parent ]] && save_parent="/"
						if [[ ! -d $save_parent ]]; then
							printf '\n%b%s%b\n' "${color_yellow}" "Warning: Directory '$save_parent' does not exist" "${color_end}" >&2
						fi
					fi
					shift 2
				else
					printf '\n%b%s%b\n' "${color_red}" "Error: --save-failed requires a file path argument" "${color_end}" >&2
					exit 1
				fi
				;;
			--save-failed=*)
				failed_patches_file="${1#*=}"
				if [[ -z $failed_patches_file ]]; then
					printf '\n%b%s%b\n' "${color_red}" "Error: --save-failed requires a file path argument" "${color_end}" >&2
					exit 1
				fi
				if [[ $failed_patches_file == */* ]]; then
					save_parent="${failed_patches_file%/*}"
					[[ -z $save_parent ]] && save_parent="/"
					if [[ ! -d $save_parent ]]; then
						printf '\n%b%s%b\n' "${color_yellow}" "Warning: Directory '$save_parent' does not exist" "${color_end}" >&2
					fi
				fi
				shift
				;;
			--)
				shift
				while [[ $# -gt 0 ]]; do
					if [[ -z $patch_dir ]]; then
						patch_dir="$1"
					else
						printf '\n%b%s%b\n' "${color_red}" "Error: Multiple patch directories specified" "${color_end}" >&2
						exit 1
					fi
					shift
				done
				break
				;;
			-h | --help)
				printf '\n%b%s%b\n' "${color_cyan}" "Usage: $script_name [OPTIONS] [patch_directory]" "${color_end}"
				printf '\n%b%s%b\n' "${color_yellow}" "Options:" "${color_end}"
				printf '\n%b%s%b\n' "${color_gray}" "  -d, --dry-run            Only check patches without applying them (default)" "${color_end}"
				printf '\n%b%s%b\n' "${color_gray}" "  -a, --apply              Actually apply patches (overrides default dry run)" "${color_end}"
				printf '\n%b%s%b\n' "${color_gray}" "  -v, --verbose            Show detailed output for debugging" "${color_end}"
				printf '\n%b%s%b\n' "${color_gray}" "  -f, --force              Try harder to apply patches (ignore whitespace, force through hunks)" "${color_end}"
				printf '\n%b%s%b\n' "${color_gray}" "  -r, --repo DIR           Target directory to apply patches to (git repo or regular directory)" "${color_end}"
				printf '\n%b%s%b\n' "${color_gray}" "  -s, --save-failed FILE   Save failed patch file names to specified file" "${color_end}"
				printf '\n%b%s%b\n' "${color_gray}" "  -x, --delete-failed      Delete failed patch files from patch directory" "${color_end}"
				printf '\n%b%s%b\n' "${color_gray}" "  -h, --help               Show this help message" "${color_end}"
				printf '\n%b%s%b\n' "${color_yellow}" "Arguments:" "${color_end}"
				printf '\n%b%s%b\n' "${color_gray}" "  patch_directory          Directory containing .patch or .diff files (default: 'patches')" "${color_end}"
				printf '\n%b%s%b\n' "${color_gray}" "                           Can be absolute or relative to current working directory" "${color_end}"
				printf '\n%b%s%b\n' "${color_magenta}" "The script automatically detects if the target is a git repository:" "${color_end}"
				printf '\n%b%s%b\n' "${color_gray}" "  - Git repositories: Uses 'git apply' with 3-way merge support" "${color_end}"
				printf '\n%b%s%b\n' "${color_gray}" "  - Regular directories: Uses 'patch' command" "${color_end}"
				printf '\n%b%s%b\n' "${color_yellow}" "Examples:" "${color_end}"
				printf '\n%b%s%b%b%s%b\n' "${color_green}" "  $script_name my-patches                    " "${color_end}" "${color_cyan}" "    # Check patches from './my-patches' (dry run)" "${color_end}"
				printf '\n%b%s%b%b%s%b\n' "${color_green}" "  $script_name -a my-patches                " "${color_end}" "${color_cyan}" "     # Apply patches from './my-patches' to current directory" "${color_end}"
				printf '\n%b%s%b%b%s%b\n' "${color_green}" "  $script_name -a -r /path/to/repo patches   " "${color_end}" "${color_cyan}" "    # Apply patches from './patches' to specified directory" "${color_end}"
				printf '\n%b%s%b%b%s%b\n' "${color_green}" "  $script_name -r my-repo my-patches         " "${color_end}" "${color_cyan}" "    # Check patches from './my-patches' for './my-repo'" "${color_end}"
				printf '\n%b%s%b%b%s%b\n' "${color_green}" "  $script_name --repo ../other-project patches   " "${color_end}" "${color_cyan}" "# Check patches from './patches' for '../other-project'" "${color_end}"
				printf '\n%b%s%b%b%s%b\n' "${color_green}" "  $script_name /abs/patches -r /abs/dir      " "${color_end}" "${color_cyan}" "    # Check patches using absolute paths" "${color_end}"
				printf '\n%b%s%b%b%s%b\n' "${color_green}" "  $script_name -d patches                    " "${color_end}" "${color_cyan}" "    # Explicitly specify dry run (same as default)" "${color_end}"
				printf '\n%b%s%b%b%s%b\n' "${color_green}" "  $script_name -a -v -f my-patches           " "${color_end}" "${color_cyan}" "    # Apply with verbose output and force mode" "${color_end}"
				printf '\n%b%s%b%b%s%b\n' "${color_green}" "  $script_name -d -s failed.txt patches      " "${color_end}" "${color_cyan}" "    # Dry run and save failed patches to 'failed.txt'" "${color_end}"
				printf '\n%b%s%b%b%s%b\n' "${color_green}" "  $script_name -d -s /tmp/fails.list patches " "${color_end}" "${color_cyan}" "    # Dry run and save failed patches with absolute path" "${color_end}"
				printf '\n%b%s%b%b%s%b\n' "${color_green}" "  $script_name -d -x patches                 " "${color_end}" "${color_cyan}" "    # Dry run and delete failed patches from patch directory" "${color_end}"
				printf '\n%b%s%b%b%s%b\n' "${color_green}" "  $script_name -d -x -v patches              " "${color_end}" "${color_cyan}" "    # Dry run, delete failed patches, and show verbose output" "${color_end}"
				printf '\n%b%s%b\n' "${color_yellow}" "Fixing Failed Patches:" "${color_end}"
				printf '\n%b%s%b\n' "${color_gray}" "  When patches fail, the script suggests recovery methods based on target type:" "${color_end}"
				printf '\n%b%s%b\n' "${color_cyan}" "  Git repositories:" "${color_end}"
				printf '\n%b%s%b\n' "${color_gray}" "    1. 3-way merge: Attempts to merge conflicts automatically" "${color_end}"
				printf '\n%b%s%b\n' "${color_gray}" "    2. Ignore whitespace: Handles whitespace-only differences" "${color_end}"
				printf '\n%b%s%b\n' "${color_gray}" "    3. Reject files: Creates .rej files for manual resolution" "${color_end}"
				printf '\n%b%s%b\n' "${color_cyan}" "  Regular directories:" "${color_end}"
				printf '\n%b%s%b\n' "${color_gray}" "    1. Ignore whitespace: Handles whitespace-only differences" "${color_end}"
				printf '\n%b%s%b\n' "${color_gray}" "    2. Different strip levels: Try -p0 instead of -p1" "${color_end}"
				printf '\n%b%s%b\n' "${color_gray}" "    3. Reject files: Creates .rej files for manual resolution" "${color_end}"
				printf '\n'
				exit 0
				;;
			-*)
				printf '\n%b%s%b\n' "${color_red}" "Unknown option: $1" "${color_end}" >&2
				printf '\n%b%s%b\n' "${color_blue}" "Use -h or --help for usage information" "${color_end}" >&2
				exit 1
				;;
			*)
				if [[ -z $patch_dir ]]; then
					patch_dir="$1"
				else
					printf '\n%b%s%b\n' "${color_red}" "Error: Multiple patch directories specified" "${color_end}" >&2
					exit 1
				fi
				shift
				;;
		esac
	done

	# Set default patch directory if not specified
	if [[ -z $patch_dir ]]; then
		patch_dir="patches"
	fi

	apply_patches "$patch_dir" "$dry_run" "$verbose" "$force" "$git_repo" "$failed_patches_file" "$delete_failed_patches"
	exit_code=$?

	printf '\n'
	exit "${exit_code:-0}"
fi
